# Multi Tenant SaaS deployment environment template.
# Copy values into your deployment platform's secret/environment settings.
# Do not commit real credentials or secrets.

# Spring runtime
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8081
FORWARD_HEADERS_STRATEGY=NONE
SHUTDOWN_TIMEOUT=20s

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/multitenant_saas
POSTGRES_USERNAME=multitenant_saas
POSTGRES_PASSWORD=CHANGE_ME

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT / authentication
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=multitenant-saas
REFRESH_TOKEN_SESSION_EXPIRATION_HOURS=12
REFRESH_TOKEN_PERSISTENT_EXPIRATION_DAYS=30
AUTH_BROWSER_COOKIE_MODE=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_PARTITIONED=false
AUTH_COOKIE_SAME_SITE=Lax

# Password reset
PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_EXPOSE_TOKEN=false
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:8080

# Initial system administrator
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=false
SYSTEM_ADMIN_BOOTSTRAP_FULL_NAME=
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=

# Login protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Email-first workspace discovery
EMAIL_VERIFICATION_EXPIRATION_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TRUSTED_BROWSER_DAYS=30
# Optional locally; if blank/unset the backend falls back to JWT_SECRET.
# In production, use a separate random secret.
EMAIL_VERIFICATION_SECRET=

# Public authentication rate limits
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_LOGIN_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_RECOVERY_MAX_REQUESTS=10
PUBLIC_RATE_LIMIT_TOKEN_MAX_REQUESTS=120
PUBLIC_RATE_LIMIT_ONBOARDING_MAX_REQUESTS=10

# Invitations
USER_INVITATION_EXPIRATION_HOURS=48

# Transactional email
MAIL_PROVIDER=logging
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MultiTenant SaaS
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3

# Durable notification email delivery
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_BATCH_SIZE=50
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_PROCESSING_TIMEOUT=5m
NOTIFICATION_DELIVERY_RETRY_BASE_DELAY=30s
NOTIFICATION_DELIVERY_RETRY_MAX_DELAY=1h
NOTIFICATION_FRONTEND_BASE_URL=http://localhost:8080

# Object storage (Cloudflare R2)
STORAGE_PROVIDER=disabled
R2_ENDPOINT=
R2_BUCKET=multitenantsaas-attachments
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_URL_EXPIRATION_MINUTES=10
R2_DOWNLOAD_URL_EXPIRATION_MINUTES=5

# Tenant outbound webhooks
# Base64 encoding of exactly 32 random bytes.
OUTBOUND_WEBHOOK_ENCRYPTION_KEY=

# Enterprise SSO / identity federation
# Base64 encoding of exactly 32 random bytes. Keep stable while encrypted
# IdP client secrets and PKCE verifiers exist.
IDENTITY_FEDERATION_ENCRYPTION_KEY=
# The IdP redirects to the backend callback.
OIDC_REDIRECT_URI=http://localhost:8081/api/auth/oidc/callback
# The backend then redirects only an opaque one-time handoff code to this frontend route.
OIDC_FRONTEND_COMPLETION_URI=http://localhost:8080/auth/oidc/complete
OIDC_AUTHORIZATION_TRANSACTION_MINUTES=5
OIDC_SESSION_HANDOFF_MINUTES=2

# Billing providers
STRIPE_BILLING_ENABLED=false
STRIPE_BILLING_ENVIRONMENT=TEST
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_SUCCESS_URL=http://localhost:8080/subscription?checkout=success
STRIPE_CANCEL_URL=http://localhost:8080/subscription?checkout=cancelled
STRIPE_WEBHOOK_ENABLED=false
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

RAZORPAY_BILLING_ENABLED=false
RAZORPAY_BILLING_ENVIRONMENT=TEST
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_WEBHOOK_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
RAZORPAY_PLAN_FREE=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ENTERPRISE=

# Frontend build-time API endpoint
VITE_API_BASE_URL=http://localhost:8081
