# Multi Tenant SaaS deployment environment template.
# Copy values into your deployment platform's secret/environment settings.
# Do not commit real credentials or secrets.

# Spring runtime

# Local Docker uses postgres.
# Production deployment should use: postgres,production
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8081
FORWARD_HEADERS_STRATEGY=NONE
SHUTDOWN_TIMEOUT=20s

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/multitenant_saas
POSTGRES_USERNAME=multitenant_saas
POSTGRES_PASSWORD=CHANGE_ME

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT / authentication
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=multitenant-saas
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Password reset
PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_EXPOSE_TOKEN=false

# Initial system administrator
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=false
SYSTEM_ADMIN_BOOTSTRAP_FULL_NAME=
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=

# Login protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Public authentication rate limits
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_LOGIN_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_RECOVERY_MAX_REQUESTS=10
PUBLIC_RATE_LIMIT_TOKEN_MAX_REQUESTS=120
PUBLIC_RATE_LIMIT_ONBOARDING_MAX_REQUESTS=10

# Invitations
USER_INVITATION_EXPIRATION_HOURS=48

# Transactional email
# Keep logging locally unless you explicitly want real delivery.
MAIL_PROVIDER=logging
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MultiTenant SaaS
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3

# Frontend build-time API endpoint
