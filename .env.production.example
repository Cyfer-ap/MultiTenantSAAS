# =========================================================
# Spring
# =========================================================

SPRING_PROFILES_ACTIVE=postgres,production
SERVER_PORT=8081

# Render terminates TLS and forwards the original request metadata.
FORWARD_HEADERS_STRATEGY=NATIVE

SHUTDOWN_TIMEOUT=20s


# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_URL=jdbc:postgresql://DATABASE_HOST:5432/multitenant_saas
POSTGRES_USERNAME=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME


# =========================================================
# Security
# =========================================================

JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=multitenant-saas

REFRESH_TOKEN_SESSION_EXPIRATION_HOURS=12
REFRESH_TOKEN_PERSISTENT_EXPIRATION_DAYS=30

# Production browser session cookies.
AUTH_BROWSER_COOKIE_MODE=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_PARTITIONED=true
AUTH_COOKIE_SAME_SITE=None

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Email-first workspace discovery
EMAIL_VERIFICATION_EXPIRATION_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TRUSTED_BROWSER_DAYS=30
EMAIL_VERIFICATION_SECRET=CHANGE_ME_TO_A_SEPARATE_RANDOM_SECRET


# =========================================================
# Password recovery
# =========================================================

PASSWORD_RESET_EXPIRATION_MINUTES=15

# Never expose password-reset tokens directly in production.
PASSWORD_RESET_EXPOSE_TOKEN=false
PASSWORD_RESET_FRONTEND_BASE_URL=https://YOUR_FRONTEND_DOMAIN


# =========================================================
# CORS
# =========================================================

CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN


# =========================================================
# System administrator bootstrap
# =========================================================

# Bootstrap should normally remain disabled once the initial
# administrator exists.
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=false

SYSTEM_ADMIN_BOOTSTRAP_FULL_NAME=
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=


# =========================================================
# Public endpoint rate limiting
# =========================================================

PUBLIC_RATE_LIMIT_ENABLED=true

PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_LOGIN_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_RECOVERY_MAX_REQUESTS=10
PUBLIC_RATE_LIMIT_TOKEN_MAX_REQUESTS=120
PUBLIC_RATE_LIMIT_ONBOARDING_MAX_REQUESTS=10


# =========================================================
# Invitations
# =========================================================

USER_INVITATION_EXPIRATION_HOURS=48


# =========================================================
# Transactional email
# =========================================================

MAIL_PROVIDER=brevo
MAIL_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
MAIL_FROM_NAME=MultiTenant SaaS
BREVO_API_KEY=CHANGE_ME
BREVO_BASE_URL=https://api.brevo.com/v3

# Durable notification email delivery
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_BATCH_SIZE=50
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_PROCESSING_TIMEOUT=5m
NOTIFICATION_DELIVERY_RETRY_BASE_DELAY=30s
NOTIFICATION_DELIVERY_RETRY_MAX_DELAY=1h
NOTIFICATION_FRONTEND_BASE_URL=https://YOUR_FRONTEND_DOMAIN


# =========================================================
# Object storage (Cloudflare R2)
# =========================================================

STORAGE_PROVIDER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=multitenantsaas-attachments
R2_REGION=auto
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_UPLOAD_URL_EXPIRATION_MINUTES=10
R2_DOWNLOAD_URL_EXPIRATION_MINUTES=5


# =========================================================
# Billing providers
# =========================================================

# Stripe and Razorpay may be enabled together. Use test-mode credentials until each
# provider completes its deployed end-to-end validation.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_SUCCESS_URL=https://YOUR_FRONTEND_DOMAIN/subscription?checkout=success
STRIPE_CANCEL_URL=https://YOUR_FRONTEND_DOMAIN/subscription?checkout=cancelled
STRIPE_WEBHOOK_ENABLED=false
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME

RAZORPAY_BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_WEBHOOK_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
RAZORPAY_PLAN_FREE=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ENTERPRISE=


# =========================================================
# Frontend build
# =========================================================

VITE_API_BASE_URL=https://YOUR_BACKEND_DOMAIN
